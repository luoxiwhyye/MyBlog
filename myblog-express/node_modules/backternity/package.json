{
  "name": "backternity",
  "version": "0.5.2",
  "description": "Composable backend modules CLI instantly add auth, db, socket, and more to your project.",
  "author": {
    "name": "Backternity",
    "email": "backternity@gmail.com"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "backend",
    "cli",
    "fullstack",
    "registry",
    "components",
    "auth",
    "database",
    "nodejs",
    "fastify",
    "express",
    "nextjs",
    "shadcn"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "backternity": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup src/cli.ts --format esm,cjs --dts --out-dir dist",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "start": "node dist/cli.js",
    "format:write": "prettier --write \"**/*.{ts,tsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,mdx}\" --cache",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm typecheck"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@types/marked-terminal": "^6.1.1",
    "commander": "^14.0.0",
    "execa": "^9.6.0",
    "fs-extra": "^11.3.1",
    "marked": "^16.4.1",
    "marked-terminal": "^7.3.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.0",
    "prettier": "^3.4.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2"
  }
}
