# -----------------------------------------------------------
# MyBlog Spring Boot 环境变量模板
# 复制此文件为 .env 并修改对应值
#
# 启动方式：
#   Linux/macOS: export $(cat .env | xargs) && ./mvnw spring-boot:run
#   Windows PS:  Get-Content .env | ForEach-Object { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }; ./mvnw spring-boot:run
# -----------------------------------------------------------

# 运行模式（通过 Spring Profiles 控制，可选: development / production）
SPRING_PROFILES_ACTIVE=development

# 服务器端口
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=myblog

# 时间字段的「源时区」（IANA 名称）——无时区的 LocalDateTime 按它解释成
# 瞬时后输出 UTC 瞬时串（与 Express 的 DB_TIME_ZONE 必须表示同一时区）。
# ⚠️ 必须等于数据库写入端时区（MySQL 会话 time_zone）；数据库改 UTC 存储时必须同步改。
APP_TIME_ZONE=Asia/Shanghai

# JWT 认证（生产环境务必修改为强随机字符串！）
# 可用 openssl rand -hex 32 生成
JWT_SECRET=your-secret-key-change-in-production
# JWT 过期时间（毫秒）；Express 端对应值为 7d（jsonwebtoken 格式，二者等价）
JWT_EXPIRES_IN=604800000

# 博主初始账户（首次运行时创建）
# ⚠️ 下面四项只在「首次创建博主」时生效（BlogInitRunner 只创建、不更新）：
#    库里已有博主时改这里**没有任何效果**，请到后台「个人资料」改昵称 / 邮箱。
# ⚠️ BLOGGER_EMAIL 是**占位地址**（example.com 是保留域名、没有 MX 记录）：
#    真实通知会全部退信（No MX Record Found），请改成你自己的邮箱。
BLOGGER_USERNAME=admin
BLOGGER_PASSWORD=admin123
BLOGGER_NICKNAME=博主
BLOGGER_EMAIL=admin@example.com

# 前端域名（用于 CORS 白名单）
FRONTEND_ORIGIN=http://localhost:3001
ADMIN_ORIGIN=http://localhost:5173

# 上传文件目录（默认 uploads，相对于工作目录）
UPLOAD_PATH=uploads

# Redis 缓存（可选，不配置则自动降级为内存缓存）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Meilisearch 全文搜索（可选；不配置或连不上则自动降级为 SQL LIKE）
# ⚠️ MEILI_HOST：本机直接跑后端时用 127.0.0.1；后端也在 Docker 里时用服务名 meilisearch
# ⚠️ MEILI_MASTER_KEY 必须与 docker-compose.yml 中容器的 MEILI_MASTER_KEY 完全一致，
#    否则会 401 → 静默降级成 SQL LIKE（搜索行为与 Express 端不一致）
MEILI_HOST=127.0.0.1
MEILI_PORT=7700
MEILI_MASTER_KEY=meili-master-key-change-me

# 站点信息（用于邮件通知中的链接与署名）
# ⚠️ 留空时邮件里的链接不会带域名（渲染成 /article/4），收信人点开是空页：
#    部署后请改成真实域名（如 https://blog.example.com），改完需重启后端。
# 注：本文件被 DotenvEnvironmentPostProcessor 当作默认层加载，.env 里的同名键会覆盖它
SITE_URL=http://localhost:3001
SITE_NAME=MyBlog

# SMTP 邮件通知（可选；不配置则评论 / 回复 / 留言的邮件通知自动停用，
# 后台「系统设置 · 邮件通知」可查看状态并发送测试邮件）
#
# 下面 4 项必须全部填满才能发信（缺任何一项都会判定为「未启用」）：
#
# SMTP_HOST —— 发信服务器地址。填邮箱服务商的 SMTP 域名，不是网页版邮箱地址。
#   常见值：QQ smtp.qq.com ｜ 163 smtp.163.com ｜ Gmail smtp.gmail.com
#          阿里云企业邮 smtp.qiye.aliyun.com ｜ Outlook smtp.office365.com
SMTP_HOST=
# SMTP_PORT —— 发信端口。上面这几个服务商统一填 465（SSL）；Outlook 用 587。
SMTP_PORT=465
# SMTP_SECURE —— 加密方式（可选；不填则按端口推导：465 → ssl，587 → starttls，其余 → none）。
#   可选值：ssl（直连 SSL）｜ starttls（先明文握手再升级）｜ none（不加密，如内网 SMTP）
#   已经填了 465 / 587 可以不管这一项；端口不是这两个时必填，否则会被当成不加密。
SMTP_SECURE=
# SMTP_USER —— 用来发信的那个邮箱的完整地址（不是用户名 / 昵称）。
#   例：yourname@qq.com
SMTP_USER=
# SMTP_PASS —— 该邮箱的「SMTP 授权码」，不是这个邮箱的登录密码。
#   QQ 邮箱：网页版「设置 → 账户」→ 开启「POP3/IMAP/SMTP 服务」→ 生成授权码
#   163 邮箱：网页版「设置 → POP3/SMTP/IMAP」→ 开启 → 新增授权码
#   Gmail：开启两步验证后生成「应用专用密码」
SMTP_PASS=
# SMTP_FROM —— 邮件里显示的「发信人」（可选；不填则回退用 SMTP_USER）。
#   写法「显示名 <邮箱>」，尖括号里的邮箱建议与 SMTP_USER 相同 ——
#   多数服务商不允许发信地址与登录账号不同域。
SMTP_FROM=
#
# ⚠️ 改完必须重启后端：配置只在进程启动时读一次
# ⚠️ 上面几项只决定「能不能发信」；通知的收件人是 blogger.email，在后台
#    「个人资料 → 邮箱」里改
