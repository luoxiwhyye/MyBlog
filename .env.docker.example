# ============================================================
# .env.docker 环境变量配置文件（Docker 部署专用）
# ============================================================
# 使用方式：
#   1. 复制此文件为 .env.docker
#   2. 修改以下配置项为实际生产值
#   3. 启动：docker compose --env-file .env.docker up -d
# ============================================================

# ── 时区（全局，写库与 SSR 直出都用它）──
# 它同时决定三件事：mysql 容器写 datetime 的墙钟、后端进程时区、前台容器 SSR 直出时间的时区。
# 只要有一处不一致，时间字段就会整体偏移且不报错。
# 改这里必须一并改 DB_TIME_ZONE（Express 读时区，固定偏移）/ APP_TIME_ZONE（Spring 源时区，IANA 名称）。
TZ=Asia/Shanghai

# ── 数据库配置 ──
DB_PASSWORD=your-strong-password-here
DB_NAME=myblog
DB_PORT=3307
# Express 后端专用：时间字段读时区（固定偏移，必须与上面的 TZ 表示同一时区）
DB_TIME_ZONE=+08:00
# Spring Boot 后端专用：时间字段源时区（IANA 名称，必须与上面的 TZ 表示同一时区）
APP_TIME_ZONE=Asia/Shanghai

# ── Redis 配置（留空则 Redis 不设置密码）──
REDIS_PASSWORD=
REDIS_PORT=6379

# ── Meilisearch 全文搜索（可选，不部署则自动降级为 SQL LIKE）──
MEILI_MASTER_KEY=meili-master-key-change-me
MEILI_PORT=7700
MEILI_HOST=meilisearch

# ── JWT 配置 ──
# ⚠️ 生产环境必须修改为高强度随机字符串！
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# ── 服务端口映射 ──
BACKEND_PORT=3000
BLOG_PORT=3001
ADMIN_PORT=3002

# ── 前端 API 地址（容器内通信）──
# 如果使用反向代理（Nginx/Traefik），这里改为实际域名
NUXT_API_BASE=http://myblog-backend:3000/api/v1
VITE_API_BASE=http://myblog-backend:3000/api/v1

# ── 站点 URL（用于 Nuxt SSR 生成绝对路径）──
NUXT_SITE_URL=http://localhost:3001

# ── CORS 允许的前端域名 ──
FRONTEND_ORIGIN=http://localhost:3001
ADMIN_ORIGIN=http://localhost:3002

# ── 博主初始账号（仅 Express 使用 initBlogger）──
# ⚠️ 下面四项只在「首次创建博主」时生效（initBlogger 只创建、不更新）：
#    库里已有博主时改这里**没有任何效果**，请到后台「个人资料」改昵称 / 邮箱。
# ⚠️ BLOGGER_EMAIL 是**占位地址**（example.com 是保留域名、没有 MX 记录）：
#    真实通知会全部退信（No MX Record Found），请改成你自己的邮箱。
BLOGGER_USERNAME=admin
BLOGGER_PASSWORD=admin123
BLOGGER_NICKNAME=博主
BLOGGER_EMAIL=admin@example.com

# ── 站点信息（用于邮件通知中的链接与署名）──
# ⚠️ SITE_URL 必须是**收信人能访问到**的地址（如 https://blog.example.com），改完重启对应容器。
#    它是邮件里文章 / 留言板链接的前缀，而点它的是收信人 —— 下面这些值都不行：
#    · 留空           → 链接不带域名（渲染成 /article/4），点开是空页
#    · localhost / 127.0.0.1 → 容器里的 localhost 只是容器自己，收信人肯定打不开
#    · 192.168.* / 10.* 等内网地址 → 只有同一内网能访问，收信人在公网点开打不开
#    本机 / 内网地址还会被邮箱的链接安全跳转拦下（QQ 邮箱直接报 Invalid url）。
#    后端每次发信前会检查并在日志里 warn 一次；后台「系统设置 · 邮件通知」也显示告警条。
SITE_URL=http://localhost:3001
SITE_NAME=MyBlog

# ── 上传资源的对外基地址（可选；仅 Express 端使用）──
# 拼入库的图片绝对地址：`<本项>/uploads/...`。不填则回退 `http://localhost:3000`。
# 前台渲染时会归一化成相对路径并改用站点域名，所以不影响页面显示；但库里的值会带着它，
# 换域名后需要回填。想让新上传的图直接用站点域名就把它设成与 SITE_URL 相同
# APP_BASE_URL=https://blog.example.com

# ── SMTP 邮件通知（可选；不配置则评论/回复/留言的邮件通知自动停用）──
# ⚠️ 下面这几项同时透传给 Express 与 Spring 两个后端服务，按你实际启用的那个生效
#
# 4 项必须全部填满才能发信（缺任何一项都会判定为「未启用」）：
#
# SMTP_HOST —— 发信服务器地址。填邮箱服务商的 SMTP 域名，不是网页版邮箱地址。
#   常见值：QQ smtp.qq.com ｜ 163 smtp.163.com ｜ Gmail smtp.gmail.com
#          阿里云企业邮 smtp.qiye.aliyun.com ｜ Outlook smtp.office365.com
SMTP_HOST=
# SMTP_PORT —— 发信端口。上面这几个服务商统一填 465（SSL）；Outlook 用 587。
SMTP_PORT=465
# SMTP_SECURE —— 加密方式（可选；不填则按端口推导：465 → ssl，587 → starttls，其余 → none）。
#   可选值：ssl（直连 SSL）｜ starttls（先明文握手再升级）｜ none（不加密，如内网 SMTP）
SMTP_SECURE=
# SMTP_USER —— 用来发信的那个邮箱的完整地址（不是用户名 / 昵称）。
#   例：yourname@qq.com
SMTP_USER=
# SMTP_PASS —— 该邮箱的「SMTP 授权码」，不是这个邮箱的登录密码。
#   QQ / 163：网页版邮箱设置里开启 POP3/IMAP/SMTP 后生成授权码
#   Gmail：开启两步验证后生成「应用专用密码」
SMTP_PASS=
# SMTP_FROM —— 邮件里显示的「发信人」（可选；不填则回退用 SMTP_USER）。
#   写法「显示名 <邮箱>」，尖括号里的邮箱建议与 SMTP_USER 相同。
SMTP_FROM=
#
# ⚠️ 改完需重启对应后端容器：docker compose restart myblog-backend
# ⚠️ 上面几项只决定「能不能发信」；通知的收件人是 blogger.email，在后台
#    「个人资料 → 邮箱」里改

# ── 反向代理信任层级（Nginx 反代默认 1；0 = 关闭）──
TRUST_PROXY=1
