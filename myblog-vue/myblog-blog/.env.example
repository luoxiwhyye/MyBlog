# -----------------------------------------------------------
# MyBlog 博客前台 环境变量模板
# 复制此文件为 .env 并修改对应值
# -----------------------------------------------------------

# 后端 API 地址（Nuxt 服务端转发用）
NUXT_API_BASE=http://localhost:3000/api/v1

# 站点公开 URL（sitemap/canonical/OG 等 SEO 功能用）
NUXT_SITE_URL=http://localhost:3001
