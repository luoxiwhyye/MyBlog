# -----------------------------------------------------------
# MyBlog Express 环境变量模板
# 复制此文件为 .env 并修改对应值
# -----------------------------------------------------------

# 运行模式（development / production）
NODE_ENV=development

# 服务器端口
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=myblog

# JWT 认证（生产环境务必修改为强随机字符串！）
# 可用 openssl rand -hex 32 生成
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# 博主初始账户（首次运行时创建）
BLOGGER_USERNAME=admin
BLOGGER_PASSWORD=admin123
BLOGGER_NICKNAME=博主
BLOGGER_EMAIL=admin@example.com

# 前端域名（用于 CORS 和静态资源跨域头）
FRONTEND_ORIGIN=http://localhost:3001
