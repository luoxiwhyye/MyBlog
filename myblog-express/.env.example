# -----------------------------------------------------------
# MyBlog Express 环境变量模板
# 复制此文件为 .env 并修改对应值
# -----------------------------------------------------------

# 运行模式（development / production）
NODE_ENV=development

# 服务器端口
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=myblog

# JWT 认证（生产环境务必修改为强随机字符串！）
# 可用 openssl rand -hex 32 生成
JWT_SECRET=your-secret-key-change-in-production
# JWT 过期时间（jsonwebtoken 格式，如 7d / 24h / 3600s）；
# Spring Boot 端对应值为 604800000（毫秒）
JWT_EXPIRES_IN=7d

# 博主初始账户（首次运行时创建）
BLOGGER_USERNAME=admin
BLOGGER_PASSWORD=admin123
BLOGGER_NICKNAME=博主
BLOGGER_EMAIL=admin@example.com

# 前端域名（用于 CORS 和静态资源跨域头）
FRONTEND_ORIGIN=http://localhost:3001

# 管理后台域名（用于 CORS 白名单）
ADMIN_ORIGIN=http://localhost:5173

# 反向代理信任层级（限流按真实访客 IP 计数所需）
# 经 Nuxt(3001) / Nginx 一层反代默认 1；多层代理按实际层数调整；0 = 关闭
TRUST_PROXY=1

# 数据库连接池（生产环境调优）
# DB_POOL_MAX=50

# Redis 缓存（可选，不配置则缓存功能自动降级为数据库直查）
# 方式一：完整连接串（优先级最高）
# REDIS_URL=redis://localhost:6379/0
# 方式二：分离配置
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# 站点 URL（用于邮件通知中的链接，如 https://blog.example.com）
SITE_URL=http://localhost:3001

# SMTP 邮件通知（可选；不配置则评论/回复邮件通知自动停用）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=noreply@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=MyBlog <noreply@example.com>
