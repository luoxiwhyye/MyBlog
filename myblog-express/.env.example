# -----------------------------------------------------------
# MyBlog Express 环境变量模板
# 复制此文件为 .env 并修改对应值
# -----------------------------------------------------------

# 运行模式（development / production）
NODE_ENV=development

# 服务器端口
PORT=3000

# 日志级别（winston）：error / warn / info / http / debug。
# 不填时按环境推导（production → info，其余 → debug）
# LOG_LEVEL=info

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=myblog

# 时间字段的「读时区」：解释 DB 里 datetime 字面量时使用的固定偏移，
# 必须与 MySQL 会话 time_zone（写入端）相同，否则时间字段会整体偏移且不报错。
# 只能是固定偏移（+08:00 / -05:30 / Z），不支持 IANA 名称；与 Spring 的 APP_TIME_ZONE 等价。
DB_TIME_ZONE=+08:00

# JWT 认证（生产环境务必修改为强随机字符串！）
# 可用 openssl rand -hex 32 生成
JWT_SECRET=your-secret-key-change-in-production
# JWT 过期时间（jsonwebtoken 格式，如 7d / 24h / 3600s）；
# Spring Boot 端对应值为 604800000（毫秒）
JWT_EXPIRES_IN=7d

# 博主初始账户（首次运行时创建）
# ⚠️ 下面四项只在「首次创建博主」时生效（initBlogger 只创建、不更新）：
#    库里已有博主时改这里**没有任何效果**，请到后台「个人资料」改昵称 / 邮箱。
# ⚠️ BLOGGER_EMAIL 是**占位地址**（example.com 是保留域名、没有 MX 记录）：
#    真实通知会全部退信（No MX Record Found），请改成你自己的邮箱。
BLOGGER_USERNAME=admin
BLOGGER_PASSWORD=admin123
BLOGGER_NICKNAME=博主
BLOGGER_EMAIL=admin@example.com

# 前端域名（用于 CORS 和静态资源跨域头）
FRONTEND_ORIGIN=http://localhost:3001

# 管理后台域名（用于 CORS 白名单）
ADMIN_ORIGIN=http://localhost:5173

# 反向代理信任层级（限流按真实访客 IP 计数所需）
# 经 Nuxt(3001) / Nginx 一层反代默认 1；多层代理按实际层数调整；0 = 关闭
TRUST_PROXY=1

# 上传资源的**对外基地址**（拼入库的图片绝对地址：`<本项>/uploads/...`）
# ⚠️ 前台渲染前会把它归一化成相对路径并改用站点域名，所以填内网地址不影响页面显示；
#    但库里的值会一直带着它，换域名后需要回填。不填则回退 `http://localhost:<PORT>`
# APP_BASE_URL=https://blog.example.com

# 数据库连接池（生产环境调优）
# DB_POOL_MAX=50

# Redis 缓存（可选，不配置则缓存功能自动降级为数据库直查）
# 方式一：完整连接串（优先级最高）
# REDIS_URL=redis://localhost:6379/0
# 方式二：分离配置
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# 启动时预热缓存（默认开启）：预取 settings / types / labels，缓解首次访问慢。
# 设为 false 关闭
# CACHE_PREHEAT=false

# 站点信息（邮件通知里的链接与署名）
# ⚠️ SITE_URL 必须是**收信人能访问到**的地址（如 https://blog.example.com），改完需重启后端。
#    它是邮件里文章 / 留言板链接的前缀，而点它的是收信人 —— 下面这些值都不行：
#    · 留空           → 链接不带域名（渲染成 /article/4），点开是空页
#    · localhost / 127.0.0.1 → 「本机」指的是收信人自己的机器，点开必然打不开
#    · 192.168.* / 10.* 等内网地址 → 只有同一内网能访问，收信人在公网点开打不开
#    本机 / 内网地址还会被邮箱的链接安全跳转拦下（QQ 邮箱直接报 Invalid url）。
#    后端每次发信前会检查并在日志里 warn 一次；后台「系统设置 · 邮件通知」也显示告警条。
SITE_URL=http://localhost:3001
# 邮件署名与主题里的站点名（不填则用 MyBlog）
SITE_NAME=MyBlog

# SMTP 邮件通知（可选；不配置则评论 / 回复 / 留言的邮件通知自动停用，不影响发布。
# 后台「系统设置 · 邮件通知」可查看当前状态并发送测试邮件）
#
# 下面 4 项必须全部填满才能发信（缺任何一项都会判定为「未启用」）：
#
# SMTP_HOST —— 发信服务器地址。填邮箱服务商的 SMTP 域名，不是网页版邮箱地址。
#   常见值：QQ smtp.qq.com ｜ 163 smtp.163.com ｜ Gmail smtp.gmail.com
#          阿里云企业邮 smtp.qiye.aliyun.com ｜ Outlook smtp.office365.com
# SMTP_PORT —— 发信端口。上面这几个服务商统一填 465（SSL）；Outlook 用 587。
# SMTP_SECURE —— 加密方式（可选；不填则按端口推导：465 → ssl，587 → starttls，其余 → none）。
#   可选值：ssl（直连 SSL）｜ starttls（先明文握手再升级）｜ none（不加密，如内网 SMTP）
#   已经填了 465 / 587 可以不管这一项；端口不是这两个时必填，否则会被当成不加密。
# SMTP_USER —— 用来发信的那个邮箱的完整地址（不是用户名 / 昵称）。
#   例：yourname@qq.com
# SMTP_PASS —— 该邮箱的「SMTP 授权码」，不是这个邮箱的登录密码。
#   QQ 邮箱：网页版「设置 → 账户」→ 开启「POP3/IMAP/SMTP 服务」→ 生成授权码
#   163 邮箱：网页版「设置 → POP3/SMTP/IMAP」→ 开启 → 新增授权码
#   Gmail：开启两步验证后生成「应用专用密码」
# SMTP_FROM —— 邮件里显示的「发信人」（可选；不填则回退用 SMTP_USER）。
#   写法「显示名 <邮箱>」，尖括号里的邮箱建议与 SMTP_USER 相同 ——
#   多数服务商不允许发信地址与登录账号不同域。
#
# ⚠️ 改完必须重启后端：.env 只在进程启动时读一次，node server.js 不热重载
# ⚠️ 上面几项只决定「能不能发信」；通知的收件人是 blogger.email，在后台
#    「个人资料 → 邮箱」里改（当前若仍是初始化的 admin@example.com 则收不到真信）
#
# 示例（以 QQ 邮箱为例，取消注释并替换成自己的值）：
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=yourname@qq.com
# SMTP_PASS=你的16位授权码
# SMTP_FROM=MyBlog <yourname@qq.com>

# Meilisearch 全文搜索（可选；不配置或连不上则自动降级为 MySQL LIKE）
# ⚠️ MEILI_HOST：本机直接跑后端时用 127.0.0.1；后端也在 Docker 里时用服务名 meilisearch
# ⚠️ MEILI_MASTER_KEY 必须与 docker-compose.yml 中容器的 MEILI_MASTER_KEY 完全一致，
#    否则请求会被拒绝、后端静默降级（表现为"看起来正常但没走搜索引擎"，不会报错）
# MEILI_HOST=127.0.0.1
# MEILI_PORT=7700
# MEILI_MASTER_KEY=meili-master-key-change-me
