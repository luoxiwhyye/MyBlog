# -----------------------------------------------------------
# MyBlog Spring Boot 环境变量模板
# 复制此文件为 .env 并修改对应值
# 启动方式：$env:DB_PASSWORD="xxx"; ./mvnw spring-boot:run
# -----------------------------------------------------------

# 运行模式（通过 spring.profiles.active 控制）
# SPRING_PROFILES_ACTIVE=development

# 服务器端口
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=myblog

# JWT 认证（生产环境务必修改为强随机字符串！）
# 可用 openssl rand -hex 32 生成
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=604800000

# 博主初始账户（首次运行时创建）
BLOGGER_USERNAME=admin
BLOGGER_PASSWORD=admin123
BLOGGER_NICKNAME=博主
BLOGGER_EMAIL=admin@example.com

# 前端域名（用于 CORS 白名单）
FRONTEND_ORIGIN=http://localhost:3001
ADMIN_ORIGIN=http://localhost:5173

# Redis 缓存（可选，不配置则自动降级为内存缓存）
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
