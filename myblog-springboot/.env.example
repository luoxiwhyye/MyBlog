# -----------------------------------------------------------
# MyBlog Spring Boot 环境变量模板
# 复制此文件为 .env 并修改对应值
#
# 启动方式：
#   Linux/macOS: export $(cat .env | xargs) && ./mvnw spring-boot:run
#   Windows PS:  Get-Content .env | ForEach-Object { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }; ./mvnw spring-boot:run
# -----------------------------------------------------------

# 运行模式（通过 Spring Profiles 控制，可选: development / production）
SPRING_PROFILES_ACTIVE=development

# 服务器端口
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=myblog

# 时间字段的「源时区」（IANA 名称）——无时区的 LocalDateTime 按它解释成
# 瞬时后输出 UTC 瞬时串（与 Express 的 DB_TIME_ZONE 必须表示同一时区）。
# ⚠️ 必须等于数据库写入端时区（MySQL 会话 time_zone）；数据库改 UTC 存储时必须同步改。
APP_TIME_ZONE=Asia/Shanghai

# JWT 认证（生产环境务必修改为强随机字符串！）
# 可用 openssl rand -hex 32 生成
JWT_SECRET=your-secret-key-change-in-production
# JWT 过期时间（毫秒）；Express 端对应值为 7d（jsonwebtoken 格式，二者等价）
JWT_EXPIRES_IN=604800000

# 博主初始账户（首次运行时创建）
BLOGGER_USERNAME=admin
BLOGGER_PASSWORD=admin123
BLOGGER_NICKNAME=博主
BLOGGER_EMAIL=admin@example.com

# 前端域名（用于 CORS 白名单）
FRONTEND_ORIGIN=http://localhost:3001
ADMIN_ORIGIN=http://localhost:5173

# 上传文件目录（默认 uploads，相对于工作目录）
UPLOAD_PATH=uploads

# Redis 缓存（可选，不配置则自动降级为内存缓存）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Meilisearch 全文搜索（可选；不配置或连不上则自动降级为 SQL LIKE）
# ⚠️ MEILI_HOST：本机直接跑后端时用 127.0.0.1；后端也在 Docker 里时用服务名 meilisearch
# ⚠️ MEILI_MASTER_KEY 必须与 docker-compose.yml 中容器的 MEILI_MASTER_KEY 完全一致，
#    否则会 401 → 静默降级成 SQL LIKE（搜索行为与 Express 端不一致）
MEILI_HOST=127.0.0.1
MEILI_PORT=7700
MEILI_MASTER_KEY=meili-master-key-change-me

# 站点信息（用于邮件通知中的链接与署名）
SITE_URL=http://localhost:3001
SITE_NAME=MyBlog

# SMTP 邮件通知（可选；不配置则评论/回复邮件通知自动停用）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
